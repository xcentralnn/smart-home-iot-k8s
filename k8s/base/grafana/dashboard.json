        {
          "query": "env = from(bucket:\"sensors\")\r\n  |> range(start:-10m)\r\n  |> filter(fn:(r)=>r._measurement==\"environment\")\r\n  |> pivot(rowKey:[\"_time\"], columnKey:[\"_field\"], valueColumn:\"_value\")\r\n\r\nanom = from(bucket:\"sensors\")\r\n  |> range(start:-10m)\r\n  |> filter(fn:(r)=>r._measurement==\"anomaly\")\r\n  |> pivot(rowKey:[\"_time\"], columnKey:[\"_field\"], valueColumn:\"_value\")\r\n\r\njoin(\r\n  tables: {env: env, anom: anom},\r\n  on: [\"_time\",\"device\"],\r\n  method: \"inner\"\r\n)\r\n|> keep(columns:[\"_time\",\"device\",\"temperature\",\"humidity\",\"score\",\"anomaly\"])",
